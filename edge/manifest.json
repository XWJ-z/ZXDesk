{
  "manifest_version": 3,
  "name": "ZXDesk 收藏夹",
  "version": "0.1.6",
  "minimum_chrome_version": "114",
  "description": "把当前网页一键收进 NAS 上的 ZXDesk 收藏夹",
  "permissions": ["storage", "cookies", "sidePanel", "contextMenus", "scripting", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": [],
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": { "default_popup": "ui/popup.html", "default_title": "收藏到 ZXDesk" },
  "side_panel": { "default_path": "ui/sidepanel.html" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "quick-save": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "收藏当前页面" }
  }
}
