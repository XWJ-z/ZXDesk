#!/bin/bash
# ZXDesk（zxdesk）离线找回管理员 / 重置密码 —— 忘记密码时的**唯一**入口
#
# 背景：界面上没有、也不应该有「找回管理员密码」的通道（那等于给所有人一个后门），
#       所以自救只能在这台 NAS 上、以 root 或应用用户身份做。
#
# 用法（SSH 到 NAS 上执行）：
#   /var/apps/zxdesk/cmd/reset-admin --list              # 只列出账号，并标出谁是管理员（先看这个）
#   /var/apps/zxdesk/cmd/reset-admin <用户名>            # 重置指定账号的密码
#   /var/apps/zxdesk/cmd/reset-admin                     # （不带参数）重置唯一的管理员密码
#   /var/apps/zxdesk/cmd/reset-admin --make-admin <用户名>  # 把某个账号**提升为管理员**（不用密码）
#
# 卡住了怎么选：
#   · 知道账号名、忘了密码   → 用 <用户名> 那条
#   · 不知道哪个账号是管理员 → 先 --list，再用 --make-admin 把你常用的账号提成管理员
#
# ⚠️ 0.2.1 起**登录名可以改**（管理员的也一样），所以别靠「叫 admin 的账号」认人 ——
#    先 `--list`，那里会把管理员标出来；不带参数时重置的是**唯一的管理员**，与它叫什么名字无关。
#
# 行为：重置密码会先问两遍新密码（不回显），再停掉应用，写库，最后提示你重新启动应用；
#       重置后该账号在所有设备上的登录都会失效（--list / --make-admin 不需要停应用）。
#
# ⚠️ 密码**不经过命令行参数**（那会留在 ps 与 shell 历史里），只通过管道送进 node。

set -u

CMD_DIR="$(cd "$(dirname "$0")" && pwd)"
PKG_DIR="$(cd "$CMD_DIR/.." && pwd)"

# node：飞牛的 node 不在默认 PATH 里
export PATH=/var/apps/nodejs_v24/target/bin:$PATH

# 应用代码目录：优先用飞牛注入的环境变量，手工执行时按脚本位置推断
# ⚠️ 0.5.0 批次 6a：目录名由 `server` 改成 `core`。三个候选必须与 `fnos/zxdesk/app/` 下的真实目录名一致
#    （`ttt/test/cmd-dir.test.js` 机械核对，写错＝装完之后自救通道打不开）。
APP_DIR="${TRIM_APPDEST:-}/core"
[ -d "$APP_DIR" ] || APP_DIR="$PKG_DIR/target/core"
[ -d "$APP_DIR" ] || APP_DIR="$PKG_DIR/app/core"

# 数据目录：data-share 的第一个路径
DATA_DIR="${DATA_DIR:-${TRIM_DATA_SHARE_PATHS:-}}"
DATA_DIR="${DATA_DIR%%:*}"
DATA_DIR="${DATA_DIR:-${TRIM_PKGVAR:-}}"

show_help() {
  sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
}

if [ ! -f "$APP_DIR/reset-admin.js" ]; then
  echo "错误：找不到应用代码 $APP_DIR/reset-admin.js"
  echo "     如果这个包是手工解开的，请用 APP_DIR=... 指定，或改用："
  echo "     DATA_DIR=/你的/data-share/zxdesk/data node \$APP_DIR/reset-admin.js <用户名>"
  exit 1
fi

if [ -z "$DATA_DIR" ]; then
  echo "错误：不知道数据目录（手工执行时飞牛不会注入 DATA_DIR / TRIM_DATA_SHARE_PATHS）。"
  echo "     请在飞牛「应用设置」里确认数据目录，然后这样运行："
  echo "     DATA_DIR=/你的/data-share/zxdesk/data $0 $*"
  exit 1
fi

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  show_help
  exit 0
fi

# --list 是只读操作：不需要停应用，也不需要输密码
if [ "$1" = "--list" ] || [ "$1" = "-l" ]; then
  DATA_DIR="$DATA_DIR" TRIM_PKGVAR="${TRIM_PKGVAR:-}" node "$APP_DIR/reset-admin.js" --list
  exit $?
fi

# --make-admin <用户名>：只改权限、不改密码，所以也不用输密码
if [ "$1" = "--make-admin" ] || [ "$1" = "-a" ]; then
  if [ -z "${2:-}" ]; then
    echo "用法：$0 --make-admin <用户名>"
    echo "     （不确定用哪个名字就先跑 $0 --list）"
    exit 1
  fi
  DATA_DIR="$DATA_DIR" TRIM_PKGVAR="${TRIM_PKGVAR:-}" node "$APP_DIR/reset-admin.js" --make-admin "$2"
  RC=$?
  if [ $RC -eq 0 ]; then
    echo "请重新启动应用后使用（登录后侧栏会出现「⚙ 成员」）。"
  fi
  exit $RC
fi

echo "数据目录：$DATA_DIR"

printf '新密码（输入时不显示）：'
read -rs PW1
echo
printf '再输一次：'
read -rs PW2
echo

if [ "$PW1" != "$PW2" ]; then
  echo "两次输入不一致，已取消。"
  exit 1
fi
if [ -z "$PW1" ]; then
  echo "密码不能为空，已取消。"
  exit 1
fi

# 停掉应用：避免两个进程同时写库（JSON 后端尤其怕这个）。
# 手工执行时 fnOS 的环境变量可能不全，停不掉就明确提示，不要装作停过了。
STOPPED=0
if [ -x "$CMD_DIR/main" ] && [ -n "${TRIM_PKGVAR:-}" ]; then
  if "$CMD_DIR/main" stop; then
    STOPPED=1
  else
    echo "警告：自动停止应用失败，请先在应用中心确认它已停止，再重新执行本脚本。"
    exit 1
  fi
else
  echo "提示：无法自动停止应用（缺少 TRIM_PKGVAR 等环境变量）。"
  echo "      请先在飞牛的应用中心里把 ZXDesk 停掉，再执行本脚本。"
fi

printf '%s' "$PW1" | DATA_DIR="$DATA_DIR" TRIM_PKGVAR="${TRIM_PKGVAR:-}" node "$APP_DIR/reset-admin.js" "$@"
RC=$?
unset PW1 PW2

if [ $RC -eq 0 ]; then
  if [ "$STOPPED" = "1" ]; then
    echo "请重新启动应用：$CMD_DIR/main start"
  else
    echo "请重新启动应用。"
  fi
fi
exit $RC
