#!/bin/bash

# PKGVAR 必须属于本应用。飞牛的 Web 终端（fntermx）会把**它自己**的
# TRIM_PKGVAR 带进 shell —— 在那个终端里手工跑 `main start/stop`，下面两行就会照着
# 只在「非空且不含 zxdesk」时报错：空值维持旧行为（某些环境不注入），⛔ 别收紧成必须匹配，
case "${TRIM_PKGVAR:-}" in
  '' | *zxdesk*) : ;;
  *)
    echo "错误：TRIM_PKGVAR（${TRIM_PKGVAR}）不属于 ZXDesk，当前 shell 不是本应用的环境。" >&2
    echo "      请在飞牛「应用中心 → ZXDesk → 启动/停止」里操作，端口与日志都由那边负责。" >&2
    exit 1
    ;;
esac

LOG_FILE="${TRIM_PKGVAR}/app.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
export PATH=/var/apps/nodejs_v24/target/bin:$PATH

# 这一行与 `cmd/reset-admin` 的两个候选路径**必须与 `fnos/zxdesk/app/` 下的真实目录名一致** ——
APP_DIR="${TRIM_APPDEST}/core"
ZXDESK_PORT=8990

# ---- 数据位置（安装时定一次，之后不再改）----
# 默认 = 安装时选的那个存储空间：`config/resource` 声明的 `zxdesk/data` 就落在它下面。
# 安装向导第 3 步若选了「自定义目录」，`cmd/install_callback` 会把绝对路径写进
SHARE_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
INSTALL_DIR_FILE="${TRIM_PKGVAR}/install-data-dir"

# 功能：取安装时指定的数据目录（一行绝对路径）；没有文件或读不出来时回空 = 用默认位置。
# @returns {string} 目录或空串
install_data_dir() {
  [ -n "${TRIM_PKGVAR:-}" ] || return 0
  [ -f "$INSTALL_DIR_FILE" ] || return 0
  head -n 1 "$INSTALL_DIR_FILE" 2>/dev/null | sed -e 's/\r$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

DATA_DIR="$SHARE_DIR"
INSTALL_DIR="$(install_data_dir)"
case "$INSTALL_DIR" in
  /?*) DATA_DIR="$INSTALL_DIR" ;;
esac
# Socket 要放在 APPDEST（= 已安装应用的 target 目录，与 app/ui/config 的 gatewaySocket: "app.sock" 对应）。
GATEWAY_PREFIX="/app/zxdesk"
SOCKET_PATH="${TRIM_APPDEST}/app.sock"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

status_app() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && grep -q 'server\.js' "/proc/$pid/cmdline" 2>/dev/null; then
      return 0
    fi
    rm -f "$PID_FILE"
  fi
  return 1
}

start_app() {
  if status_app; then
    log_msg "ZXDesk 已在运行"
    return 0
  fi
  # 确保应用 home 目录存在（飞牛 package 用户无真实 home，写文件会 EACCES）
  HOME_DIR="${TRIM_PKGHOME:-${TRIM_APPHOME:-${TRIM_PKGVAR}/home}}"
  mkdir -p "$HOME_DIR" 2>/dev/null
  chown zxdesk:zxdesk "$HOME_DIR" 2>/dev/null || true
  chmod 700 "$HOME_DIR" 2>/dev/null || true
  # 确保数据目录存在
  if [ -n "$DATA_DIR" ]; then
    mkdir -p "$DATA_DIR" 2>/dev/null
    # 自定义位置（安装时指定）：只建目录 + **实测可写**，不再改属主。
    # 为什么这里必须实测：安装时能建目录不代表应用用户能写（属主没交出去、卷没挂上、权限被人改了）。
    # 验不过就退回默认位置并把原因写进日志 —— 宁可「这几个小时先用默认位置」，
    if [ "$DATA_DIR" != "$SHARE_DIR" ]; then
      if ( : >"$DATA_DIR/.zxdesk-write-test" ) 2>/dev/null; then
        rm -f "$DATA_DIR/.zxdesk-write-test" 2>/dev/null
        log_msg "数据目录：安装时指定的位置 $DATA_DIR"
      else
        log_msg "警告：安装时指定的数据目录不可写（$DATA_DIR），本次改用默认位置 ${SHARE_DIR} —— 修好权限后重启即可切回"
        DATA_DIR="$SHARE_DIR"
        mkdir -p "$DATA_DIR" 2>/dev/null
      fi
    fi
    # 只在属主不对时才递归改，且**只对默认位置**做：自定义目录可能是用户已有的目录，
    # 对它递归 chown 等于毁别人的文件。数据目录含协作附件与备份，每次启停遍历整棵树也会随数据量变慢。
    # 修正失败不再静默吞掉 —— 与「静默降级不可接受」的口径一致。
    if [ "$DATA_DIR" = "$SHARE_DIR" ] && [ "$(stat -c %U "$DATA_DIR" 2>/dev/null)" != "zxdesk" ]; then
      chown -R zxdesk:zxdesk "$DATA_DIR" 2>/dev/null ||
        log_msg "警告：数据目录属主修正失败（$DATA_DIR）——请检查目录是否被其它账号占用"
    fi
  fi
  [ -d "$APP_DIR" ] || { log_msg "错误：APPDEST/core 不存在"; return 1; }
  # 上一次没停干净会留下 Socket 文件，直接 listen 会 EADDRINUSE（server.js 里也会先删一次，
  # 这里是第二道保险：真机上「文件在、没人听」的表现是桌面图标点了没反应）
  [ -n "$SOCKET_PATH" ] && rm -f "$SOCKET_PATH" 2>/dev/null
  cd "$APP_DIR" || exit 1
  ZXDESK_PORT="$ZXDESK_PORT" DATA_DIR="$DATA_DIR" \
    TRIM_PKGVAR="$TRIM_PKGVAR" TRIM_PKGETC="$TRIM_PKGETC" \
    ZXDESK_HOME="$HOME_DIR" \
    GATEWAY_PREFIX="$GATEWAY_PREFIX" SOCKET_PATH="$SOCKET_PATH" \
    node server.js >> "$LOG_FILE" 2>&1 &
  echo "$!" > "$PID_FILE"
  log_msg "ZXDesk 已启动（端口 $ZXDESK_PORT，数据目录 $DATA_DIR，网关 Socket $SOCKET_PATH，前缀 $GATEWAY_PREFIX）"
  return 0
}

stop_app() {
  log_msg "停止 ZXDesk…"
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null
      # 轮询等待进程真正退出（最多 5 秒），不再「sleep 2 后无条件 kill -9」。
      #
      # 为什么：server.js 收到 SIGTERM 后要写收尾日志、让 SQLite 正常关闭（WAL 收尾）。
      local waited=0
      while [ "$waited" -lt 25 ] && kill -0 "$pid" 2>/dev/null; do
        sleep 0.2
        waited=$((waited + 1))
      done
      if kill -0 "$pid" 2>/dev/null; then
        log_msg "警告：进程 $pid 在 5 秒内未退出，强制结束（-9）"
        kill -9 "$pid" 2>/dev/null
      else
        log_msg "进程 $pid 已正常退出（等待约 $((waited * 200)) 毫秒）"
      fi
    fi
    rm -f "$PID_FILE"
  fi
  # 表现就是「应用明明起来了，桌面图标却打不开」—— 与「文件在、没人听」同一种难查。
  if [ -n "$SOCKET_PATH" ] && [ -e "$SOCKET_PATH" ]; then
    rm -f "$SOCKET_PATH" 2>/dev/null && log_msg "已清理网关 Socket：$SOCKET_PATH"
  fi
  log_msg "已停止"
  return 0
}

case "$1" in
  start)
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    status_app
    ;;
  *)
    exit 1
    ;;
esac
