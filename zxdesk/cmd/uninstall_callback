#!/bin/bash
# 卸载 ZXDesk（zxdesk）飞牛原生应用 —— 按卸载向导的选择处理用户数据。
#
# 规则（五条，一条都不能省）：
#   ① 默认保留：没选、参数缺失、系统异常卸载 —— 一律不动数据；
#   ② 先过卸载确认：「我已知晓，确认卸载」没勾（`wizard_uninstall_ack` 不是 yes）→ 保留；
#   ③ 双条件才删：「选择删除数据」＋「确认已导出备份」同时成立才执行，
#      只选一样（最常见的是选了删除却没勾确认）→ 保留，并写日志说明原因；
#   ④ 跟着索引走：数据可能被搬到别的目录（设置 →「修改位置」），删除必须按
#      `data-location.json` 里的 `current` 去删真实位置，而不是只认安装时那个文件夹；
#   ⑤ 只删认得出来的数据目录：路径形状对、目录里得有我们的标记或库文件 —— 不像就跳过，
#      绝不对上级目录动手。
#
# ⚠️ 迁移之后，默认目录里**只剩索引与归档（zip）**，没有主库 —— 旧版「必须有主库才认」
#    的守卫会把它误判成「不是数据目录」而跳过，于是「删除数据」变成什么都没删。
#
# 数据位置：安装时由 config/resource 的 data-share 决定，路径在 TRIM_DATA_SHARE_PATHS
# （冒号分隔，可能不止一个）。⛔ 不是 TRIM_PKGVAR —— 那里只有日志与 pid。

LOG_FILE="${TRIM_PKGVAR}/app.log"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE" 2>/dev/null
}

ACTION="${wizard_data_action:-keep}"
CONFIRM="${wizard_backup_confirmed:-}"

if [ "$ACTION" != "remove" ]; then
  log_msg "卸载：按用户选择保留数据（wizard_data_action=${ACTION}）"
  exit 0
fi

# 卸载确认（向导里是勾选框，默认不勾）。这里再判一次是**防御**：
# 万一前端没拦住、或系统在异常路径下调用，仍按「没勾就不删」处理。
# ⚠️ checkbox 传下来的值可能是 `yes`，也可能是数组字面量 `["yes"]` 或 `yes,...` —— 用通配兜住。
case "${wizard_uninstall_ack:-}" in
  *yes* | *true*) ;;
  *)
    log_msg "卸载：没有收到卸载确认（wizard_uninstall_ack=${wizard_uninstall_ack:-空}）—— 已保留数据"
    exit 0
    ;;
esac

case "$CONFIRM" in
  *yes* | *true*) ;;
  *)
    log_msg "卸载：用户选了「删除数据」但备份确认没有选「已导出」（wizard_backup_confirmed=${CONFIRM:-空}）—— 已保留数据，未删除任何文件"
    exit 0
    ;;
esac

IFS=':' read -r -a DIRS <<< "${TRIM_DATA_SHARE_PATHS:-}"

NODE_BIN=/var/apps/nodejs_v24/target/bin/node
[ -x "$NODE_BIN" ] || NODE_BIN="$(command -v node 2>/dev/null || true)"

# 功能：从一个索引文件里读出 `current`。读不到就回空串，⛔ 不猜路径。
read_current() {
  local f="$1"
  [ -f "$f" ] || return 0
  if [ -n "$NODE_BIN" ] && [ -x "$NODE_BIN" ]; then
    "$NODE_BIN" -e 'try{const o=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));if(o&&o.app==="zxdesk"&&typeof o.current==="string")process.stdout.write(o.current)}catch(e){}' "$f" 2>/dev/null
    return 0
  fi
  # 没有 node：只做字段级文本提取（值里不会有转义引号，路径是明文）
  grep -o '"current"[[:space:]]*:[[:space:]]*"[^"]*"' "$f" 2>/dev/null | head -n 1 |
    sed -e 's/^[^:]*:[[:space:]]*"//' -e 's/"$//'
}

# 功能：这张目录像不像「本应用的数据目录」。索引存在也算 —— 迁移后的默认目录只有索引与归档。
is_data_dir() {
  local p="$1"
  [ -d "$p" ] || return 1
  if [ -f "$p/zxdesk.db" ] || [ -f "$p/zxdesk.json" ]; then return 0; fi
  if [ -f "$p/data-location.json" ] && grep -q '"app"[[:space:]]*:[[:space:]]*"zxdesk"' "$p/data-location.json"; then
    return 0
  fi
  return 1
}

# 功能：删一个**自定义**位置。三重守卫全过才动手，任何一条不过就跳过。
delete_custom() {
  local p="${1%/}"
  case "$p" in
    '' | / | /vol1 | /vol2 | /vol3 | /mnt | /media | /home | /root | /var | /tmp | /etc | /usr | /boot)
      log_msg "卸载：拒绝删除过浅或系统级路径 $p"
      return 1
      ;;
  esac
  if [ "$(echo "$p" | awk -F/ '{print NF-1}')" -lt 3 ]; then
    log_msg "卸载：拒绝删除层级过浅的路径 $p"
    return 1
  fi
  if [ ! -f "$p/.zxdesk-data.json" ]; then
    log_msg "卸载：$p 没有 ZXDesk 的数据标记，判定不是本应用数据目录，未删除"
    return 1
  fi
  if [ ! -f "$p/zxdesk.db" ] && [ ! -f "$p/zxdesk.json" ]; then
    log_msg "卸载：$p 里没有 ZXDesk 的库文件，未删除"
    return 1
  fi
  if rm -rf "$p"; then
    log_msg "卸载：已按用户确认删除自定义数据位置 $p"
    return 0
  fi
  log_msg "卸载：删除 $p 失败（权限或占用），数据仍在，用户可手工清理"
  return 1
}

DEFAULT_DIR=""
for p in "${DIRS[@]}"; do
  [ -n "$p" ] || continue
  p="${p%/}"
  case "$p" in
    */zxdesk/data) DEFAULT_DIR="$p" ;;
    *) log_msg "卸载：跳过非本应用数据目录 $p" ;;
  esac
done

CURRENT=""
for f in "${DEFAULT_DIR}/data-location.json" "${TRIM_PKGVAR:-}/data-location.json"; do
  [ -n "$f" ] || continue
  CURRENT="$(read_current "$f")"
  [ -n "$CURRENT" ] && break
done

# 先删自定义位置：删不掉就**保留索引**，下次重装还能找回（⛔ 不能出现「索引没了、数据还在」）
if [ -n "$CURRENT" ] && [ "${CURRENT%/}" != "$DEFAULT_DIR" ]; then
  if ! delete_custom "$CURRENT"; then
    log_msg "卸载：自定义数据位置未删除成功，已保留索引（下次重装仍能找回数据）"
    exit 0
  fi
elif [ -n "$CURRENT" ]; then
  log_msg "卸载：当前数据位置就是安装位置（$CURRENT）"
fi

if [ -n "$DEFAULT_DIR" ]; then
  if ! is_data_dir "$DEFAULT_DIR"; then
    log_msg "卸载：$DEFAULT_DIR 既没有索引也没有库文件，判定不是本应用数据目录，未删除"
  elif rm -rf "$DEFAULT_DIR"; then
    log_msg "卸载：已按用户确认删除数据目录 $DEFAULT_DIR（含索引与归档）"
    # 数据已被用户确认删除 ⇒ 应用私有目录里那份索引指向的目录已经不存在了，
    # 必须一并清掉：否则重装后读到旧索引，会判成「数据位置不可用」进恢复页，而不是首次设置页。
    # 再写一个标记，供重装后的启动判定区分「数据被主动删除」与「数据暂时够不着（盘没挂上）」。
    # ⚠️ 顺序不能反：先删索引再写标记 —— 反过来中途失败会留下「有标记但索引还在」的自相矛盾状态。
    # ⚠️ TRIM_PKGVAR 在非标准安装下可能为空，判空后再拼路径，绝不拼出 `/data-location.json`。
    if [ -n "${TRIM_PKGVAR:-}" ]; then
      rm -f "${TRIM_PKGVAR}/data-location.json"
      if [ -f "${TRIM_PKGVAR}/data-location.json" ]; then
        log_msg "卸载：应用私有目录里的索引没能删掉，重装后可能仍进恢复页"
      fi
      printf '{"app":"zxdesk","wipedAt":"%s"}\n' "$(date '+%Y-%m-%dT%H:%M:%S')" > "${TRIM_PKGVAR}/data-wiped.json"
      log_msg "卸载：已清除数据位置索引并写入「数据已删除」标记"
    fi
  else
    log_msg "卸载：删除 $DEFAULT_DIR 失败（权限或占用），数据仍在，用户可手工清理"
  fi
fi

exit 0
