#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/app.log"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE" 2>/dev/null
}

ACTION="${wizard_data_action:-keep}"
CONFIRM="${wizard_backup_confirmed:-}"

if [ "$ACTION" != "remove" ]; then
  log_msg "卸载：按用户选择保留数据（wizard_data_action=${ACTION}）"
  exit 0
fi

# 卸载确认（向导里是勾选框，默认不勾）。这里再判一次是**防御**：
# 万一前端没拦住、或系统在异常路径下调用，仍按「没勾就不删」处理。
# checkbox 传下来的值可能是 `yes`，也可能是数组字面量 `["yes"]` 或 `yes,...` —— 用通配兜住。
case "${wizard_uninstall_ack:-}" in
  *yes* | *true*) ;;
  *)
    log_msg "卸载：没有收到卸载确认（wizard_uninstall_ack=${wizard_uninstall_ack:-空}）—— 已保留数据"
    exit 0
    ;;
esac

case "$CONFIRM" in
  *yes* | *true*) ;;
  *)
    log_msg "卸载：用户选了「删除数据」但备份确认没有选「已导出」（wizard_backup_confirmed=${CONFIRM:-空}）—— 已保留数据，未删除任何文件"
    exit 0
    ;;
esac

IFS=':' read -r -a DIRS <<< "${TRIM_DATA_SHARE_PATHS:-}"

# 功能：这张目录像不像「本应用的数据目录」（认得出来的库文件才算）。
is_data_dir() {
  local p="$1"
  [ -d "$p" ] || return 1
  if [ -f "$p/zxdesk.db" ] || [ -f "$p/zxdesk.json" ]; then return 0; fi
  return 1
}

DEFAULT_DIR=""
for p in "${DIRS[@]}"; do
  [ -n "$p" ] || continue
  p="${p%/}"
  case "$p" in
    */zxdesk/data) DEFAULT_DIR="$p" ;;
    *) log_msg "卸载：跳过非本应用数据目录 $p" ;;
  esac
done

# 真实数据位置只有一个来源 —— 安装时选的那个（`$TRIM_PKGVAR/install-data-dir`）。
# 没有这个文件就是安装位置（data-share 的 zxdesk/data）。⛔ 不再有位置索引。
CURRENT=""
if [ -n "${TRIM_PKGVAR:-}" ] && [ -f "${TRIM_PKGVAR}/install-data-dir" ]; then
  CURRENT="$(head -n 1 "${TRIM_PKGVAR}/install-data-dir" 2>/dev/null | sed -e 's/\r$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
fi
case "$CURRENT" in
  /?*) : ;;
  *) CURRENT="" ;;
esac

# 自定义目录**一律不删**：那是用户在安装时自己指定（可能原本就装着别的东西）的目录，
# 应用没有资格替用户清空它 —— 即便勾了「删除数据」，也只删应用自己的安装位置。
# 数据留在原处，用户想清的时候自己去文件管理里删。
if [ -n "$CURRENT" ] && [ "${CURRENT%/}" != "$DEFAULT_DIR" ]; then
  log_msg "卸载：数据在自定义目录 $CURRENT —— 按约定不动用户选择的目录，未删除任何文件（需清除请手工删除）"
elif [ -n "$CURRENT" ]; then
  log_msg "卸载：当前数据位置就是安装位置（$CURRENT）"
fi

if [ -n "$DEFAULT_DIR" ]; then
  if ! is_data_dir "$DEFAULT_DIR"; then
    log_msg "卸载：$DEFAULT_DIR 里没有本应用的库文件，判定不是数据目录，未删除"
  elif rm -rf "$DEFAULT_DIR"; then
    log_msg "卸载：已按用户确认删除数据目录 $DEFAULT_DIR"
    # 重装后的启动判定只看目录本身（打不开就报错退出，⛔ 不会在原地建空库）。
  else
    log_msg "卸载：删除 $DEFAULT_DIR 失败（权限或占用），数据仍在，用户可手工清理"
  fi
fi

exit 0
